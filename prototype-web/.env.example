# Copy this file to .env and fill in your key to turn on the Qwen tier.
# Get a key from Alibaba Cloud Model Studio (百炼): https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Optional
# QWEN_MODEL=qwen-plus
# Mainland China endpoint (default). Outside mainland China use:
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PORT=5173
