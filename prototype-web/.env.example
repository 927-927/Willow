# Copy this file to .env and fill in your key to turn on the AI tier.
# The same file feeds the Android build (android/willow.sh install): rebuild after changing it.
# .env is never committed (see .gitignore).

# DeepSeek (default): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional
# DEEPSEEK_MODEL=deepseek-flash          (DeepSeek V4.1 Flash, the cheap one; deepseek-v4-pro costs ~4x more)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / 百炼 instead: https://bailian.console.aliyun.com/
# Used when DEEPSEEK_API_KEY is empty, or when AI_PROVIDER=qwen.
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   (outside mainland China: https://dashscope-intl.aliyuncs.com/compatible-mode/v1)

# AI_PROVIDER=deepseek
# PORT=5173
