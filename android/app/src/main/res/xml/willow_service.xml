<?xml version="1.0" encoding="utf-8"?>
<!-- Only WeChat is observed. canPerformGestures lets 换一个视频 and swipes on the explanation
     card move the feed, exactly as if he had swiped himself.
     canTakeScreenshot: WeChat hides its views from accessibility, so Willow reads a screenshot with
     on-phone OCR instead. The picture never leaves the phone.
     flagInputMethodEditor (Android 13+): lets the hobby button type 钓鱼 into Channels search.
     Used only right after he taps that button; Willow never reads what is typed.
     typeWindowContentChanged / typeWindowsChanged are ignored in code but must be subscribed:
     Android refreshes the service's cached screen tree from them. Without them Willow saw a
     stale, empty WeChat window (found on the test phone, 2026-10-12). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewScrolled|typeWindowContentChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagInputMethodEditor"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:canPerformGestures="true"
    android:notificationTimeout="50"
    android:packageNames="com.tencent.mm"
    android:description="@string/service_description" />
