<?xml version="1.0" encoding="utf-8"?>
<!-- Willow (柳荫): mutes, checks and gently explains fear-based health scam videos in WeChat Channels.
     No monitoring: nothing is stored, screenshots are read on the phone and thrown away, and only the
     on-screen text of an unclear video is sent to the AI (Qwen). No restricting: every explanation has 继续看原视频. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for asking the AI about unclear videos. Without a key in the build, nothing goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- Look up WeChat's activity names (Android 11+ package visibility). -->
        <package android:name="com.tencent.mm" />
        <!-- Find the phone's text-to-speech engine for the spoken explanation. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ML Kit (the OCR) would send its usage statistics to Google through this library.
             Without its upload backend those statistics are dropped on the phone, so the only thing
             Willow ever sends anywhere is an unclear video's on-screen text, to the AI. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />

        <service
            android:name=".WillowService"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/willow_service" />
        </service>
    </application>
</manifest>
